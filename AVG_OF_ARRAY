package uniflow;
import java.util.Scanner;
public class avg_of_array {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc=new Scanner(System.in);
		int m=sc.nextInt();
		int n=sc.nextInt();
		int[][] a=new int[m][n];
		int i,j,sum=0,s,avg;
		for(i=0;i<m;i++) {
			for(j=0;j<n;j++) {
				a[i][j]=sc.nextInt();
				
			}
		}
		for (i=0;i<m;i++) {
			for(j=0;j<n;j++) {
				sum=sum+a[i][j];
				
			}
		}
		s=m*n;
		avg=sum/s;
		System.out.println("avg="+avg);
			
			
		

	}

}
