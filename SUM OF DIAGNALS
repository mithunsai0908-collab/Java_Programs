package uniflow2;
import java.util.Scanner;


public class two_diagonal_sum {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		
		int[][] a=new int[n][n];
		int i,j;
		for (i=0;i<n;i++) {
			for(j=0;j<n;j++) {
				a[i][j]=sc.nextInt();
			}
		}
			int s1=0,s2=0;
			for (i=0;i<n;i++) {
				for(j=0;j<n;j++) {
				if (i==j) {
					s1=s1+a[i][j];
				}
				if (i+j==n) {
					s2=s2+a[i][j];
				}
				
				}
			

	}
			System.out.println("sum of diagonal="+(s1+s2));
}
}

